extends "res://scenes/world_1_lorentz/level_base.gd"
## M2-2 关卡控制器 — "闭合类时曲线"
##
## 教学：虫洞时间差 → CTC → 回到过去开启门
## 谜题：
##   1. 门关着，无法通过
##   2. 找到虫洞 B，按 F 拖入引力区 → 时间差激活
##   3. 进虫洞 A → 进入"过去回响"→ 门打开
##   4. 穿过门按下开关
##   5. 再次进虫洞返回现在 → 门保持开启
##   6. 穿门通关


func _get_hints() -> Array:
	return [
		{"text": "门关着... 也许虫洞能带你绕过去？", "pos": Vector2(300, 500)},
		{"text": "站在虫洞 B 旁按 [F] 拖拽它 → 放入引力区", "pos": Vector2(550, 500)},
		{"text": "时间差激活后，从虫洞 A 穿越到过去", "pos": Vector2(250, 400)},
	]
